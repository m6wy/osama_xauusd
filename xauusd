    <style>
        @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap');
        
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Cairo', sans-serif; }
        body { background: #05070a; color: #e2e8f0; min-height: 100vh; display: flex; flex-direction: column; align-items: center; }
        
        header { width: 100%; background: #0a0f18; border-bottom: 2px solid #2d240d; padding: 20px; text-align: center; box-shadow: 0 4px 20px rgba(212, 175, 55, 0.05); }
        .logo { font-size: 26px; font-weight: 900; background: linear-gradient(135deg, #facc15, #d4af37, #937113); -webkit-background-clip: text; -webkit-text-fill-color: transparent; letter-spacing: 1px; }
        .sub-logo { font-size: 13px; color: #64748b; margin-top: 5px; font-weight: 700; letter-spacing: 2px; }

        main { width: 100%; max-width: 850px; padding: 30px 20px; display: flex; flex-direction: column; gap: 30px; flex: 1; }

        .card { background: #0b111a; border: 1px solid #1e293b; border-radius: 20px; padding: 30px; box-shadow: 0 10px 40px rgba(0,0,0,0.5); position: relative; overflow: hidden; }
        .card::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 4px; background: linear-gradient(90deg, #d4af37, #facc15, #d4af37); }
        .card-title { font-size: 18px; font-weight: bold; color: #fff; margin-bottom: 20px; text-align: center; }

        .upload-area { border: 2px dashed #334155; border-radius: 16px; padding: 40px 20px; text-align: center; cursor: pointer; transition: all 0.3s ease; background: #0f172a; position: relative; }
        .upload-area:hover { border-color: #d4af37; background: #131c30; }
        .upload-area input { position: absolute; inset: 0; opacity: 0; cursor: pointer; z-index: 10; }
        .upload-icon { font-size: 40px; margin-bottom: 15px; }
        .upload-text { font-size: 16px; color: #cbd5e1; font-weight: bold; }
        .upload-sub { font-size: 12px; color: #64748b; margin-top: 8px; }

        .preview-container { display: none; text-align: center; margin-top: 20px; animation: fadeIn 0.5s ease; }
        .preview-img { max-width: 100%; max-height: 350px; border-radius: 12px; border: 2px solid #334155; box-shadow: 0 5px 20px rgba(0,0,0,0.5); }
        
        .analyze-btn { margin-top: 25px; background: linear-gradient(135deg, #d4af37, #937113); color: #000; font-size: 18px; font-weight: 900; padding: 15px 40px; border: none; border-radius: 12px; cursor: pointer; transition: all 0.3s ease; width: 100%; box-shadow: 0 10px 25px rgba(212, 175, 55, 0.2); }
        .analyze-btn:hover { transform: translateY(-2px); box-shadow: 0 15px 30px rgba(212, 175, 55, 0.4); }

        .loader { display: none; text-align: center; margin-top: 25px; }
        .spinner { width: 50px; height: 50px; border: 4px solid #1e293b; border-top: 4px solid #d4af37; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto; }
        .loader-text { margin-top: 15px; color: #d4af37; font-weight: bold; font-size: 15px; animation: pulse 1.5s infinite; }

        .results-grid { display: none; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 30px; animation: slideUp 0.6s ease; }
        @media(max-width: 650px) { .results-grid { grid-template-columns: 1fr; } }

        .result-box { background: #0f172a; border: 1px solid #1e293b; border-radius: 16px; padding: 25px; position: relative; overflow: hidden; }
        .result-box.scalp { border-top: 4px solid #10b981; }
        .result-box.swing { border-top: 4px solid #3b82f6; }
        
        .box-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid #1e293b; padding-bottom: 15px; }
        .box-title { font-size: 18px; font-weight: 900; color: #fff; }
        .badge { padding: 4px 10px; border-radius: 8px; font-size: 11px; font-weight: bold; }
        .badge.scalp { background: rgba(16, 185, 129, 0.1); color: #10b981; }
        .badge.swing { background: rgba(59, 130, 246, 0.1); color: #3b82f6; }

